# --- Data backend ---
# demo     = seeded in-memory store, demo sign-in (local dev, CI, Playwright)
# supabase = real Postgres with RLS + Supabase Auth
DATA_BACKEND=demo
# Mirror of DATA_BACKEND for the browser (selects Realtime vs polling for live updates).
NEXT_PUBLIC_DATA_BACKEND=demo

# --- Supabase (required when DATA_BACKEND=supabase) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the integration webhooks and cron jobs, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Only this email domain may sign in (Google or magic link).
ALLOWED_EMAIL_DOMAIN=konnectorllc.com

# --- Konnect Hub integration ---
# Base URL of the Konnect Hub integration API. Leave empty with MOCK_KONNECT_HUB=true to use
# the built-in mock at /api/mock-konnect-hub.
KONNECT_HUB_BASE_URL=
KONNECT_HUB_WEB_URL=https://hub.konnectorllc.com
MOCK_KONNECT_HUB=true
# Shared HMAC-SHA256 secret for X-Konnector-Signature (both directions). Generate with: openssl rand -hex 32
KONNECTOR_INTEGRATION_SECRET=

# Bearer token required by /api/cron/* (daily expiry job, retries, digest).
CRON_SECRET=

# Optional: daily digest email via Resend. Without it, /api/cron/daily builds digests but doesn't send.
RESEND_API_KEY=
DIGEST_FROM=Konnector CRM <crm@konnectorllc.com>
# Public base URL (used in signed document links sent to Konnect Hub).
APP_URL=http://localhost:3000

# --- PI-2 ---
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts OAuth tokens and webhook secrets at rest.
APP_ENCRYPTION_KEY=
# Konnector Copilot (server-side only; never exposed to the browser). Without it Copilot runs in demo mode.
ANTHROPIC_API_KEY=
COPILOT_MODE=auto

# --- Email & calendar sync (docs/MAIL.md) ---
# Google Cloud OAuth client (Web application). Redirect URI: $APP_URL/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Azure app registration (Web platform). Redirect URI: $APP_URL/api/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Directory (tenant) id, or "common" for any work/school account.
MICROSOFT_TENANT_ID=common
# auto (default): live when client id+secret are set, mock on the demo backend otherwise.
# mock: always use the built-in fake mailbox. live: never fall back to the mock.
MAIL_PROVIDER_MODE=auto

# --- Observability (docs/OPERATIONS.md) ---
# Optional: errors are also POSTed here as JSON (fire-and-forget). Logs always go to stdout as JSON lines.
ERROR_WEBHOOK_URL=
# Optional: short commit shown by GET /api/health on hosts other than Vercel (Vercel sets VERCEL_GIT_COMMIT_SHA).
APP_COMMIT_SHA=
