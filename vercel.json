{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/integrations",
      "schedule": "15 10 * * *"
    },
    {
      "path": "/api/cron/mail-sync",
      "schedule": "35 10 * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "55 10 * * *"
    }
  ]
}
